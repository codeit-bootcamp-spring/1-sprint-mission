<configuration>

  <!-- Spring Boot 색상 지원을 위한 설정 포함 -->
  <appender class="ch.qos.logback.core.ConsoleAppender" name="Console">
    <encoder>
      <charset>UTF-8</charset>
      <pattern>${CONSOLE_LOG_PATTERN}</pattern>
    </encoder>
  </appender>

  <!-- 로그 파일 경로 -->
  <appender class="ch.qos.logback.core.rolling.RollingFileAppender" name="FileAppender">
    <encoder>
      <charset>UTF-8</charset>
      <pattern>${FILE_LOG_PATTERN}</pattern>
    </encoder>
    <file>${LOG_FILE}</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>${LOG_PATH}/application.%d{yyyy-MM-dd}.log</fileNamePattern>
      <maxHistory>30</maxHistory>
    </rollingPolicy>
  </appender>
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

  <!-- 콘솔 로그 패턴 -->
  <property name="CONSOLE_LOG_PATTERN"
    value="%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr([%thread]){faint} %clr([%X{requestId}]){yellow} %clr(%X{method}){green} %clr(%X{uri}){magenta} %highlight(%-5level) %clr(%logger{36}){cyan} - %msg%n"/>

  <!-- 파일 로그 패턴 (색상 없음) -->
  <property name="FILE_LOG_PATTERN"
    value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{requestId}] %X{method} %X{uri} %-5level %-36logger - %msg%n"/>


  <!-- 콘솔 로그 -->
  <property name="LOG_PATH" value=".logs"/>

  <!-- 파일 로그 -->
  <property name="LOG_FILE" value="${LOG_PATH}/application.log"/>

  <!-- 루트 로거 설정 -->
  <root level="INFO">
    <appender-ref ref="Console"/>
    <appender-ref ref="FileAppender"/>
  </root>

</configuration>
