<configuration>
  <!--파일은 {프로젝트 루트}/.logs 경로에 저장되도록 설정 -->
  <property name="LOG_PATH" value="./.logs"/>
  <conversionRule conversionWord="clr"
    converterClass="org.springframework.boot.logging.logback.ColorConverter"/>
  <conversionRule conversionWord="customHighlight"
    converterClass="com.sprint.mission.discodeit.log.CustomHighlightConverter"/>
  <!-- 콘솔로 출력 -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%blue(%d{yyyy-MM-dd HH:mm:ss.SS}) %boldCyan([%thread]) %customHighlight(%-5level) %logger{36}-%msg%n</pattern>
    </encoder>
  </appender>

  <!-- 파일로 출력 (RollingFileAppender) -->
  <appender name="FILE"
    class="ch.qos.logback.core.rolling.RollingFileAppender"> <!--  이 클래스는 로그 파일이 일정 크기나 일정 기간에 도달했을 때 새로운 파일로 롤링하는 기능을 지원 -->
    <file>${LOG_PATH}/app.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <!-- 날짜별 파일 분할 // app.log 파일이 생기는데 이름 패턴이 적용안됨 자정 지나고도 그런지 확인해 볼 것-->
      <fileNamePattern>${LOG_PATH}/app.%d{yyyy-MM-dd}.log</fileNamePattern>
      <maxHistory>30</maxHistory> <!-- 30일치 보관 -->
    </rollingPolicy>
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- 최상위 root 로거 레벨: INFO -->
  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="FILE"/>
  </root>

  <!-- 패키지별 다른 레벨 설정 예 (디버그가 필요한 Service) -->
  <logger name="com.example.demo.service" level="DEBUG"/>
</configuration>
