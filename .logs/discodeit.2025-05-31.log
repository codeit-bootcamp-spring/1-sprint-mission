        s1_0.updated_at,
        s1_0.user_id,
        a1_0.updated_at,
        a1_0.username,
        m1_0.channel_id,
        m1_0.content,
        m1_0.created_at,
        m1_0.updated_at 
    from
        messages m1_0 
    left join
        users a1_0 
            on a1_0.id=m1_0.author_id 
    join
        user_statuses s1_0 
            on a1_0.id=s1_0.user_id 
    left join
        binary_contents p1_0 
            on p1_0.id=a1_0.profile_id 
    where
        m1_0.channel_id=? 
        and m1_0.created_at<? 
    order by
        m1_0.created_at desc 
    fetch
        first ? rows only
