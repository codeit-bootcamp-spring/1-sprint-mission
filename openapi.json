    "/api/users/{userId}": {
      "put": {
        "tags": [
          "Users"
        ],
        "summary": "사용자 정보 수정",
        "description": "선택적 프로필 이미지와 함께 사용자 정보를 수정합니다.",
        "operationId": "update",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "description": "수정할 사용자의 ID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "required": [
                  "userUpdateRequest"
                ],
                "type": "object",
                "properties": {
                  "userUpdateRequest": {
                    "type": "string",
                    "description": "사용자 정보 수정 내용"
                  },
                  "profile": {
                    "type": "string",
                    "description": "선택적 새 프로필 이미지",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "사용자 정보 수정 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "404": {
            "description": "사용자를 찾을 수 없음",
            "content": {
              "*/*": {
                "example": "User with id {userId} not found"
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Users"
        ],
        "summary": "사용자 삭제",
        "description": "특정 사용자를 삭제합니다.",
        "operationId": "delete",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "description": "삭제할 사용자의 ID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "사용자 삭제 성공"
          },
          "404": {
            "description": "사용자를 찾을 수 없음",
